# gifthub-rust-payments configuration. Copy to `.env` (gitignored) and fill in.
# No Redis, no queue — this gateway is pull-based: it polls Django's due-list endpoint on its own
# timer and POSTs results back. RUST_LOG=info is required to see any logs (env_logger logs nothing
# by default without it).

# --- Django endpoints ---
# Both co-located with Django, so point at the local Granian (WSGI :8000) — bypasses nginx/TLS.
# nginx must still deny external access to /internal/.
DJANGO_DUE_URL=http://127.0.0.1:8000/internal/payments/due/            # required
DJANGO_CALLBACK_URL=http://127.0.0.1:8000/internal/payments/callback/  # required
PAYMENT_GATEWAY_WEBHOOK_SECRET=<REDACTED>   # required; MUST equal Django's PAYMENT_GATEWAY_WEBHOOK_SECRET
                                             # (used both as the due-list Bearer token and the callback HMAC key)
# CALLBACK_MAX_ATTEMPTS=5                # bounded retries on a failed callback POST, then drop (next poll tick retries the item)
# CALLBACK_TIMEOUT_SECS=15               # per-attempt timeout for the callback POST

# --- Worker tuning ---
# POLL_INTERVAL_SECS=15                  # how often to GET the due-list; ticks overlap (no waiting for the previous tick's items to finish)
# MAX_CONCURRENCY=8
# CONNECT_TIMEOUT_SECS=10
# REQUEST_TIMEOUT_SECS=30
RUST_LOG=info                            # env_logger filter — required to see any log output at all

# --- NOWPayments ---
# NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_API_KEY=<REDACTED>            # required; same key Django's NOWPAYMENTS_API_KEY uses

# --- Cryptomus ---
# CRYPTOMUS_BASE_URL=https://api.cryptomus.com/v1
CRYPTOMUS_MERCHANT_ID=<REDACTED>          # required; same value as Django's CRYPTOMUS_MERCHANT_ID
CRYPTOMUS_API_KEY=<REDACTED>               # required; same key Django's CRYPTOMUS_API_KEY uses
